{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerRegister",
  "type": "object",
  "required": ["hostname", "version", "supported_task_types", "capacity"],
  "properties": {
    "hostname": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "supported_task_types": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "capacity": { "type": "integer", "minimum": 1 },
    "cpu_capacity_units": {
      "type": "integer",
      "minimum": 1,
      "description": "Schedulable CPU capacity. 1000 units is roughly one logical CPU."
    },
    "memory_capacity_mb": {
      "type": "integer",
      "minimum": 1,
      "description": "Schedulable memory capacity in megabytes."
    }
  }
}
