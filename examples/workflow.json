{
  "name": "order-risk-processing-pipeline",
  "metadata": {
    "owner": "platform",
    "use_case": "resume-demo",
    "workload": "trusted-integration-workflow"
  },
  "tasks": [
    {
      "task_id": "validate-order-batch",
      "task_type": "validate_payload",
      "input_payload": {
        "records": [
          {
            "id": "ord-1001",
            "amount": 42.75,
            "currency": "usd",
            "customer_tier": "standard",
            "country": "us",
            "channel": "pos"
          },
          {
            "id": "ord-1002",
            "amount": 1275.2,
            "currency": "usd",
            "customer_tier": "new",
            "country": "ng",
            "channel": "web"
          },
          {
            "id": "ord-1003",
            "amount": 560.0,
            "currency": "eur",
            "customer_tier": "vip",
            "country": "de",
            "channel": "card_not_present"
          }
        ],
        "required_fields": ["id", "amount", "currency", "customer_tier", "country"],
        "field_types": {
          "id": "string",
          "amount": "number",
          "currency": "string",
          "customer_tier": "string",
          "country": "string"
        },
        "unique_key": "id",
        "reject_on_invalid": true
      },
      "timeout_seconds": 10,
      "priority": 80,
      "cpu_units": 250,
      "memory_mb": 128,
      "expected_duration_seconds": 2,
      "retry_policy": {
        "max_attempts": 3,
        "initial_backoff_seconds": 2,
        "max_backoff_seconds": 20,
        "multiplier": 2
      },
      "idempotency_key": "order-risk-validate-v1"
    },
    {
      "task_id": "normalize-order-records",
      "task_type": "transform_records",
      "dependencies": ["validate-order-batch"],
      "input_payload": {
        "records": [
          {
            "id": "ord-1001",
            "amount": 42.75,
            "currency": "usd",
            "customer_tier": "standard",
            "country": "us",
            "channel": "pos"
          },
          {
            "id": "ord-1002",
            "amount": 1275.2,
            "currency": "usd",
            "customer_tier": "new",
            "country": "ng",
            "channel": "web"
          },
          {
            "id": "ord-1003",
            "amount": 560.0,
            "currency": "eur",
            "customer_tier": "vip",
            "country": "de",
            "channel": "card_not_present"
          }
        ],
        "select_fields": ["id", "amount", "currency", "customer_tier", "country", "channel"],
        "rename_fields": {
          "amount": "order_amount"
        },
        "uppercase_fields": ["currency", "country"],
        "lowercase_fields": ["customer_tier", "channel"],
        "round_fields": {
          "order_amount": 2
        },
        "add_fields": {
          "pipeline_version": "orders-v1"
        }
      },
      "timeout_seconds": 10,
      "priority": 70,
      "cpu_units": 350,
      "memory_mb": 192,
      "expected_duration_seconds": 3,
      "retry_policy": {
        "max_attempts": 3,
        "initial_backoff_seconds": 2,
        "max_backoff_seconds": 20,
        "multiplier": 2
      },
      "idempotency_key": "order-risk-transform-v1"
    },
    {
      "task_id": "run-risk-inference",
      "task_type": "model_inference",
      "dependencies": ["normalize-order-records"],
      "input_payload": {
        "model_name": "order-risk-rules-v1",
        "id_field": "id",
        "fail_until_attempt": 1,
        "retryable_failure": true,
        "records": [
          {
            "id": "ord-1001",
            "order_amount": 42.75,
            "currency": "USD",
            "customer_tier": "standard",
            "country": "US",
            "channel": "pos"
          },
          {
            "id": "ord-1002",
            "order_amount": 1275.2,
            "currency": "USD",
            "customer_tier": "new",
            "country": "NG",
            "channel": "web"
          },
          {
            "id": "ord-1003",
            "order_amount": 560.0,
            "currency": "EUR",
            "customer_tier": "vip",
            "country": "DE",
            "channel": "card_not_present"
          }
        ],
        "rules": [
          {
            "field": "order_amount",
            "operator": "gte",
            "value": 1000,
            "score": 0.45,
            "contributor": "large_order"
          },
          {
            "field": "order_amount",
            "operator": "gte",
            "value": 500,
            "score": 0.2,
            "contributor": "elevated_order_value"
          },
          {
            "field": "country",
            "operator": "in",
            "values": ["NG", "IR", "KP"],
            "score": 0.3,
            "contributor": "high_risk_country"
          },
          {
            "field": "channel",
            "operator": "in",
            "values": ["web", "card_not_present"],
            "score": 0.1,
            "contributor": "remote_channel"
          },
          {
            "field": "customer_tier",
            "operator": "eq",
            "value": "new",
            "score": 0.1,
            "contributor": "new_customer"
          }
        ],
        "decision_thresholds": {
          "review": 0.45,
          "block": 0.8
        }
      },
      "timeout_seconds": 10,
      "priority": 95,
      "cpu_units": 1000,
      "memory_mb": 384,
      "expected_duration_seconds": 5,
      "retry_policy": {
        "max_attempts": 3,
        "initial_backoff_seconds": 2,
        "max_backoff_seconds": 20,
        "multiplier": 2
      },
      "idempotency_key": "order-risk-inference-v1"
    },
    {
      "task_id": "aggregate-risk-metrics",
      "task_type": "aggregate_metrics",
      "dependencies": ["run-risk-inference"],
      "input_payload": {
        "predictions": [
          {
            "id": "ord-1001",
            "score": 0.05,
            "decision": "approve",
            "contributors": ["base"]
          },
          {
            "id": "ord-1002",
            "score": 0.99,
            "decision": "block",
            "contributors": ["base", "large_order", "elevated_order_value", "high_risk_country", "remote_channel", "new_customer"]
          },
          {
            "id": "ord-1003",
            "score": 0.35,
            "decision": "approve",
            "contributors": ["base", "elevated_order_value", "remote_channel"]
          }
        ]
      },
      "timeout_seconds": 10,
      "priority": 60,
      "cpu_units": 300,
      "memory_mb": 128,
      "expected_duration_seconds": 2,
      "retry_policy": {
        "max_attempts": 2,
        "initial_backoff_seconds": 1,
        "max_backoff_seconds": 5,
        "multiplier": 2
      },
      "idempotency_key": "order-risk-aggregate-v1"
    },
    {
      "task_id": "write-risk-artifact",
      "task_type": "write_artifact",
      "dependencies": ["aggregate-risk-metrics"],
      "input_payload": {
        "sink": "local",
        "dataset": "order_risk_daily_scores",
        "base_path": "/tmp/helios-artifacts",
        "artifact": {
          "workflow": "order-risk-processing-pipeline",
          "summary": {
            "prediction_count": 3,
            "avg_score": 0.463,
            "max_score": 0.99,
            "decision_counts": {
              "approve": 2,
              "block": 1
            }
          }
        }
      },
      "timeout_seconds": 10,
      "priority": 50,
      "cpu_units": 200,
      "memory_mb": 128,
      "expected_duration_seconds": 1,
      "retry_policy": {
        "max_attempts": 2,
        "initial_backoff_seconds": 1,
        "max_backoff_seconds": 5,
        "multiplier": 2
      },
      "idempotency_key": "order-risk-artifact-v1"
    },
    {
      "task_id": "notify-risk-ops",
      "task_type": "notify_webhook",
      "dependencies": ["write-risk-artifact"],
      "input_payload": {
        "dry_run": true,
        "method": "POST",
        "url": "https://ops.example.local/hooks/order-risk",
        "body": {
          "workflow": "order-risk-processing-pipeline",
          "status": "artifact-ready",
          "dataset": "order_risk_daily_scores"
        }
      },
      "timeout_seconds": 10,
      "priority": 40,
      "cpu_units": 100,
      "memory_mb": 64,
      "expected_duration_seconds": 1,
      "retry_policy": {
        "max_attempts": 2,
        "initial_backoff_seconds": 1,
        "max_backoff_seconds": 5,
        "multiplier": 2
      },
      "idempotency_key": "order-risk-notify-v1"
    }
  ]
}
