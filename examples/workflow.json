{
  "name": "fraud-ai-risk-pipeline",
  "metadata": {
    "owner": "platform",
    "use_case": "resume-demo",
    "workload": "trusted-fraud-risk-scoring"
  },
  "tasks": [
    {
      "task_id": "validate-transaction-batch",
      "task_type": "validate_records",
      "input_payload": {
        "records": [
          {
            "id": "txn-1001",
            "amount": 42.75,
            "currency": "usd",
            "merchant_id": "merchant-a",
            "country": "us",
            "channel": "pos"
          },
          {
            "id": "txn-1002",
            "amount": 1275.2,
            "currency": "usd",
